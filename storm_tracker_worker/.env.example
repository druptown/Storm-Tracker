STV3_MQTT_HOST=homeassistant.local
STV3_MQTT_PORT=1883
STV3_MQTT_USERNAME=storm_tracker_worker
STV3_MQTT_PASSWORD=change-me
STV3_MQTT_TOPIC_ROOT=storm_tracker/v1
STV3_MQTT_TLS=false
STV3_QUEUE_SIZE=16
STV3_COMPUTE_PROFILE=dedicated_nas
STV3_WORKER_NICE=15
STV3_CPU_LIMIT_PERCENT=40
STV3_HEARTBEAT_SECONDS=30
STV3_PROVIDER_CYCLE_SECONDS=60
STV3_LOG_LEVEL=INFO
STV3_RUNTIME_MODE=worker_only
STV3_WORKER_FIRST_CONFIG_PATH=
STV3_WORKER_FIRST_CONFIG_SHA256=
STV3_WORKER_FIRST_AUTHORITY_SHA256=
STV3_WORKER_ONLY_ROOT=/share/storm_tracker_worker/runtime/worker_only_production_v1
STV3_DATA_DIR=/volume1/storm_tracker
STV3_CONTAINER_MEMORY_LIMIT=1536m
STV3_CONTAINER_CPU_LIMIT=2.0

# Optionele, asynchrone PostGIS-projectie. De lokale raw-store blijft leidend.
STV3_POSTGIS_ENABLED=false
STV3_POSTGIS_HOST=192.168.0.21
STV3_POSTGIS_PORT=5433
STV3_POSTGIS_DATABASE=storm_tracker
STV3_POSTGIS_USER=storm_ingest
STV3_POSTGIS_PASSWORD=
STV3_POSTGIS_SSLMODE=disable
STV3_POSTGIS_CONNECT_TIMEOUT=3

# Providercredentials blijven optioneel en uitsluitend worker-side.
STV3_NETATMO_CLIENT_ID=
STV3_NETATMO_CLIENT_SECRET=
STV3_NETATMO_REFRESH_TOKEN=
STV3_NETATMO_TOKEN_STATE=/share/storm_tracker_worker/private/netatmo_token_state.json
STV3_SYNOPTIC_TOKEN=
# Enige toegestane waarde na expliciete acceptatie:
# worker_authority.synoptic_raw_retention_terms_v1
STV3_SYNOPTIC_RAW_RETENTION_AUTHORITY=
# Enige toegestane waarde na expliciete acceptatie:
# worker_authority.rainviewer_cache_attribution_v1
STV3_RAINVIEWER_CACHE_ATTRIBUTION_AUTHORITY=
# Enige toegestane waarde na expliciete toestemming:
# worker_authority.kmi_appv4_raw_retention_v1
STV3_KMI_APPV4_RAW_RETENTION_AUTHORITY=
# Enige toegestane waarde na expliciete toestemming:
# worker_authority.opera_raw_retention_v1
STV3_OPERA_RAW_RETENTION_AUTHORITY=
# Enige toegestane waarde voor deelnemers of met expliciete toestemming:
# worker_authority.blitzortung_participant_raw_retention_v1
STV3_BLITZORTUNG_RAW_RETENTION_AUTHORITY=
STV3_KNMI_API_KEY=
STV3_AEMET_API_KEY=
STV3_METEOFRANCE_API_TOKEN=
STV3_METEOFRANCE_APPLICATION_ID=
STV3_HSAF_USERNAME=
STV3_HSAF_PASSWORD=
STV3_EUMETSAT_CONSUMER_KEY=
STV3_EUMETSAT_CONSUMER_SECRET=
STV3_JOB_RECEIPT_DB=/share/storm_tracker_worker/state/service_job_receipts.sqlite3
